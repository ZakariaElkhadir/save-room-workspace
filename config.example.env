# ─────────────────────────────────────────────────────────────────────────────
#  start-environment configuration file
#  Copy this file to:
#    ~/.config/start-environment/config.env
#    OR keep it as 'config.env' in the same directory as start-environment.sh
# ─────────────────────────────────────────────────────────────────────────────

# --- Session & Personalization ---
# Name displayed in the startup greeting banner (defaults to capitalized $USER)
# SESSION_USER="Zakaria"

# --- Ambient Audio / Soundscape ---
# Optional: Path to your ambient audio track or soundscape (leave empty to disable)
AUDIO_FILE=""
AUDIO_VOLUME=100

# Delay (in seconds) between application launches
# LAUNCH_DELAY=1.0

# --- Display Identifiers ---
# Physical monitor connector names (run `./start-environment.sh --status` to see connected monitors).
# If unassigned or disconnected, start-environment automatically detects primary and external screens.
# CONSOLE_DISPLAY="eDP-1"     # Laptop panel / Primary display
# WORKSPACE_DISPLAY="HDMI-2"  # External workspace monitor (e.g. HDMI-1, DP-1, USB-C)
# CONSOLE_LABEL="laptop"
# WORKSPACE_LABEL="HP screen"

# --- Application Binaries ---
# Commands to launch. If the binary name is different on your distro, override it here:
# IDE_CMD="antigravity-ide"           # e.g., "code", "cursor", "vscodium"
# BRAVE_CMD="brave-browser-stable"    # e.g., "brave-browser", "brave", "firefox"
# CLAUDE_CMD="claude-desktop"         # e.g., "claude"
# TERMINAL_CMD="ghostty"              # e.g., "ghostty", "gnome-terminal", "kitty"

# --- Dual-Screen Window Layouts ---
# Format: "X Y WIDTH HEIGHT" as fractions of the target monitor (0.0 to 1.0)
# (Windows never touch 1.0 to preserve elegant margins and avoid accidental full-screen)
# LAYOUT_CONSOLE="0.06 0.08 0.42 0.82"   # Console terminal  — laptop, left half
# LAYOUT_SAVEROOM="0.52 0.08 0.42 0.82"  # Save Room terminal — laptop, right half
# LAYOUT_IDE="0.02 0.05 0.58 0.88"       # Main IDE           — external, left column
# LAYOUT_BROWSER="0.62 0.05 0.36 0.53"   # Browser            — external, upper right
# LAYOUT_CLAUDE="0.62 0.60 0.36 0.33"    # Claude Desktop     — external, lower right

# --- Single-Screen Fallback Layouts ---
# Used when disconnected from external displays (e.g. laptop alone)
# SINGLE_LAYOUT_CONSOLE="0.02 0.05 0.40 0.44"
# SINGLE_LAYOUT_SAVEROOM="0.02 0.52 0.40 0.42"
# SINGLE_LAYOUT_IDE="0.44 0.05 0.54 0.89"
# SINGLE_LAYOUT_BROWSER="0.44 0.05 0.54 0.50"
# SINGLE_LAYOUT_CLAUDE="0.44 0.57 0.54 0.37"
